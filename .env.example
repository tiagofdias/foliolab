# Local development uses SQLite in data/folio.db without these variables.
# Set these in Render's environment settings, never in browser/VITE variables.
TURSO_DATABASE_URL=libsql://your-database-your-org.turso.io
TURSO_AUTH_TOKEN=replace-with-your-database-token
# Production Blueprint requires remote persistent storage:
# REQUIRE_REMOTE_DB=true
# HOST=0.0.0.0
# NODE_ENV=production
