{
  "name": "folio-lab",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "audit:markets": "node scripts/audit-european-coverage.mjs",
    "dev": "node server/dev.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "playwright test",
    "format": "prettier --write src/App.tsx src/index.css src/components/workbench src/data src/services/useLiveFeed.ts shared server tests vite.config.ts playwright.config.ts"
  },
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "chart.js": "^4.6.1",
    "chartjs-plugin-zoom": "^2.2.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-chartjs-2": "^5.3.1",
    "react-dom": "^19.3.1",
    "read-excel-file": "^9.3.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
